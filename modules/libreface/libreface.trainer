<?xml version="1.0" ?>
<trainer ssi-v="5">
<info trained="true"/>
<meta backend="nova-server" category="Face" description="Aligns face (GPU) and predicts LibreFace AUs (detection + intensity), facial expression and embeddings" is_iterable="False">
    <io type="input" id="video" data="stream:Video" default_value="video" />
    <io type="input" id="landmarks" data="stream:SSIStream:feature;face;landmarks;facemesh" default_value="face_mesh" />
    <io type="output" id="action_units" data="stream:SSIStream:feature;face;actionunits;libreface" default_value="libreface_au" />
    <io type="output" id="expression" data="annotation:Discrete" default_value="emotion" />
    <io type="output" id="aligned" data="stream:Video" default_value="face_aligned" />
    <io type="output" id="embedding" data="stream:SSIStream:feature;face;embedding;libreface" default_value="libreface_embedding" />
    <io type="output" id="au_embedding" data="stream:SSIStream:feature;face;embedding;libreface" default_value="libreface_au_embedding" />
</meta>
<model create="LibreFace" script="libreface_script.py" optstr="{batch_size:STRING:256};{min_conf:STRING:0.5}"/>
</trainer>
